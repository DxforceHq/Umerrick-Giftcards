
DJANGO_SETTINGS_MODULE=umerrick.settings.production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_AGE=28800
DATABASE_URL=mysql://umerrick_app:replace-password@db.example.internal:3306/umerrick
