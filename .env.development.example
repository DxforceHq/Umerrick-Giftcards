
DJANGO_SETTINGS_MODULE=umerrick.settings.development
DJANGO_SECRET_KEY=dev-only-local-secret-replace-if-shared
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app
# Leave DATABASE_URL unset to use SQLite (db.sqlite3).
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/umerrick_dev
